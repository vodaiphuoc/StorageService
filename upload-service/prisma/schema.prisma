generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id   String  @id @map("user_id") @default("123")
    name String?
    file File[]

    @@map("user")
}

model File {
    id           String   @id @map("file_id")
    fileName     String   @map("file_name")
    folderPath   String?  @map("folder_path")
    mimeType     String   @map("mine_type")
    totalChunk   Int      @map("total_chunk")
    isComplete   Boolean  @default(false) @map("is_complete")
    createdAt    DateTime @default(now()) @map("create_at")
    uploadStatus Status   @default(PENDING) @map("upload_status")

    User   User?   @relation(fields: [userId], references: [id])
    userId String? @map("user_id")

    @@map("file")
}



enum Status {
    PENDING
    FAILED
    SUCCESS
}
