{
  "name": "upload-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "_moduleAliases": {
    "@": "dist",
    "@controllers": "dist/controllers",
    "@middlewares": "dist/middlewares",
    "@routes": "dist/routes",
    "@models": "dist/models",
    "@utils": "dist/utils",
    "@generated-prisma": "dist/generated/prisma",
    "@lib": "dist/lib"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:prisma:binary",
    "copy:prisma:binary": "cp ./src/generated/prisma/libquery_engine-debian-openssl-3.0.x.so.node ./dist/generated/prisma/",
    "prisma:migrate": "npx prisma migrate deploy",
    "start": "npm run prisma:migrate && npm run build && node dist/index.js"
  },
