    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "module-alias": "^2.2.3",
    "tslib": "^2.8.1",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
